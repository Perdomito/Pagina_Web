# Copia este archivo como .env y completa los valores

# Neon PostgreSQL connection string
# Formato: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:TU_PASSWORD@TU_HOST.neon.tech/neondb?sslmode=require

# JWT Secret Key — genera uno seguro con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_muy_larga

# Algoritmo de cifrado JWT
ALGORITHM=HS256

# Duracion del token de acceso (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Entorno: development / production
ENVIRONMENT=development

# Almacenamiento de archivos adjuntos (Supabase Storage)
# Crea un bucket PUBLICO en Supabase y pega aqui la URL del proyecto y la service_role key.
# Si se dejan vacias, POST /archivos responde 503 (no configurado).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key
SUPABASE_BUCKET=archivos